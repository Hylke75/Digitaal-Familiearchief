# =============================================================================
# Digital Life Archive — environment template
# Copy to `apps/web/.env.local` for local development. NEVER commit real values.
# Required variables are validated at application startup (see apps/web/lib/env.ts).
# =============================================================================

# --- Supabase (public, safe for the browser) -------------------------------
# Project API URL, e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key (safe to expose to the browser; RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, NEVER expose to the browser) -------------------
# Service-role key bypasses Row Level Security. Server-side use only.
# Leave empty in the browser build; only set in trusted server environments.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application -----------------------------------------------------------
# Default UI locale (nl-NL is the product default). Options: nl-NL | en
NEXT_PUBLIC_DEFAULT_LOCALE=nl-NL

# Public site URL (used for absolute links / auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Token encryption (Phase 4+; provider OAuth tokens) --------------------
# Base64-encoded 32-byte key used to encrypt provider refresh tokens at rest.
# Not required for Phase 0. See docs/security.md.
TOKEN_ENCRYPTION_KEY=
