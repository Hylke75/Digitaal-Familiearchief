# =============================================================================
# Bewora — environment template
# Copy to `apps/web/.env.local` for local development. NEVER commit real values.
# Required variables are validated at application startup (see apps/web/lib/env.ts).
# =============================================================================

# --- Application -----------------------------------------------------------
# Canonical public app URL (production domain). Used to build OAuth callback and
# application URLs. e.g. https://bewora.nl
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (public, safe for the browser) -------------------------------
# Project API URL, e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key (safe to expose to the browser; RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, NEVER expose to the browser) -------------------
# Service-role key bypasses Row Level Security. Server-side use only.
# Leave empty in the browser build; only set in trusted server environments.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application -----------------------------------------------------------
# Default UI locale (nl-NL is the product default). Options: nl-NL | en
NEXT_PUBLIC_DEFAULT_LOCALE=nl-NL

# Public site URL (used for absolute links / auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Token encryption (Phase 4+; provider OAuth tokens) --------------------
# Base64-encoded 32-byte key used to encrypt provider refresh tokens at rest.
# Base64-encoded 32-byte key. Generate: openssl rand -base64 32
# Required before any OAuth connector stores provider credentials. See docs/security.md.
TOKEN_ENCRYPTION_KEY=

# --- Connector feature flags (server-side) ---------------------------------
# A connector is only offered in production when its flag is enabled AND its
# code + provider approval are complete. Archive-import fallbacks stay available
# regardless. See docs/PROVIDER_SETUP.md and docs/connectors/README.md.
GOOGLE_DRIVE_ENABLED=false
ONEDRIVE_ENABLED=false
DROPBOX_ENABLED=false
TIKTOK_ENABLED=false
GOOGLE_PHOTOS_ENABLED=false
APPLE_PHOTOS_ENABLED=false
INSTAGRAM_ENABLED=false
FACEBOOK_ENABLED=false
SNAPCHAT_ENABLED=false
X_ENABLED=false
LOCAL_UPLOAD_ENABLED=false
META_TRANSFER_ENABLED=false

# --- Provider OAuth credentials (server-side, add when each is approved) ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# DROPBOX_CLIENT_ID=
# DROPBOX_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
