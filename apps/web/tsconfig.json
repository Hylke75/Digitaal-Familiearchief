{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@dla/shared": ["../../packages/shared/src"],
      "@dla/i18n": ["../../packages/i18n/src"],
      "@dla/import": ["../../packages/import/src"],
      "@dla/oauth": ["../../packages/oauth/src"],
      "@dla/database": ["../../packages/database/src"],
      "@dla/storage": ["../../packages/storage/src"],
      "@dla/connectors": ["../../packages/connectors/src"],
      "@dla/archive": ["../../packages/archive/src"],
      "@dla/security": ["../../packages/security/src"],
      "@dla/ui": ["../../packages/ui/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
